# Kopier til .env.local og fyll inn verdier.
# Alt med VITE_-prefiks eksponeres i nettleseren (kun offentlige nøkler her).

# Supabase – finnes i Supabase → Project Settings → API
# NB: velg EU-region når du oppretter prosjektet (helsedata = særkategori under GDPR).
VITE_SUPABASE_URL=https://ditt-prosjekt.supabase.co
VITE_SUPABASE_ANON_KEY=din-anon-key

# Edge Functions-base (for e-postsending av rapport – se EPOST.md).
# Uten denne er nedlasting/utskrift tilgjengelig, men ikke «send på e-post».
VITE_FUNCTIONS_URL=https://ditt-prosjekt.functions.supabase.co

# Allowlist (privat app): kommaseparerte e-poster som får bruke appen.
# Tom = alle innloggede slipper inn. Skru også AV offentlig signup i Supabase
# (Authentication → Sign In / Providers → Email → «Allow new users to sign up»).
# For delt konto (to personer, ett datasett): list begge – se DELT_KONTO.md.
VITE_TILLATT_EPOST=mt@centragruppen.no,familiemedlem@epost.no

# ────────────────────────────────────────────────────────────────
# Server-/CI-hemmeligheter settes IKKE her. De hører hjemme som
# GitHub Actions-secrets for Garmin-synken (se GARMIN.md):
#   SUPABASE_SERVICE_ROLE_KEY   (kun til Garmin-skriveren – aldri i nettleseren)
#   GARMIN_TOKENS               (base64 av garth-token fra lokal bootstrap)
